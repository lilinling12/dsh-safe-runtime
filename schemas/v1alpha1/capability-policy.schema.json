{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safe-runtime.dev/schema/v1alpha1/capability-policy.schema.json",
  "title": "CapabilityPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "safe-runtime.dev/v1alpha1"
    },
    "kind": {
      "const": "CapabilityPolicy"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultEffect",
        "rules"
      ],
      "properties": {
        "defaultEffect": {
          "const": "deny"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "effect",
              "capabilities",
              "resources"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "effect": {
                "type": "string",
                "enum": [
                  "allow",
                  "deny",
                  "ask"
                ]
              },
              "capabilities": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 3
                }
              },
              "resources": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "subjects": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "constraints": {
                "type": "object",
                "additionalProperties": true
              },
              "lease": {
                "$ref": "defs.schema.json#/$defs/leaseRequest"
              },
              "priority": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              }
            }
          }
        },
        "delegation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "inheritByDefault"
          ],
          "properties": {
            "mode": {
              "const": "attenuating"
            },
            "inheritByDefault": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safe-runtime.dev/schema/v1alpha1/check-result.schema.json",
  "title": "CheckResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "checkResultRef", "checkRef", "status", "evidenceRefs", "startedAt", "completedAt"],
  "properties": {
    "apiVersion": { "const": "safe-runtime.dev/v1alpha1" },
    "kind": { "const": "CheckResult" },
    "checkResultRef": { "$ref": "defs.schema.json#/$defs/ref" },
    "checkRef": { "$ref": "defs.schema.json#/$defs/ref" },
    "status": { "type": "string", "enum": ["pass", "fail", "error", "skipped"] },
    "evidenceRefs": { "type": "array", "items": { "$ref": "defs.schema.json#/$defs/ref" } },
    "message": { "type": "string", "maxLength": 8192 },
    "startedAt": { "$ref": "defs.schema.json#/$defs/timestamp" },
    "completedAt": { "$ref": "defs.schema.json#/$defs/timestamp" }
  }
}

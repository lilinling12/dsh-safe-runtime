{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safe-runtime.dev/schema/v1alpha1/acceptance-contract.schema.json",
  "title": "AcceptanceContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "safe-runtime.dev/v1alpha1"
    },
    "kind": {
      "const": "AcceptanceContract"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completionPolicy",
        "checks",
        "onFailure"
      ],
      "properties": {
        "completionPolicy": {
          "type": "string",
          "enum": [
            "all-required",
            "any-required"
          ]
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "required"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "type": {
                "type": "string",
                "enum": [
                  "command",
                  "workspace-diff",
                  "rule",
                  "external"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "command": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1
              },
              "expect": {
                "type": "object",
                "additionalProperties": true
              },
              "allow": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "deny": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rule": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "command"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "properties": {
                    "command": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "command"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "rule"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "properties": {
                    "rule": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "rule"
                  ]
                }
              }
            ]
          }
        },
        "onFailure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "maxRetries",
            "afterExhaustion"
          ],
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "steer",
                "block",
                "report"
              ]
            },
            "maxRetries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "afterExhaustion": {
              "type": "string",
              "enum": [
                "blocked",
                "failed"
              ]
            }
          }
        }
      }
    }
  }
}

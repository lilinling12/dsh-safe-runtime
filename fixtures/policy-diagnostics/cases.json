    {
      "id": "future-fields-ignored",
      "policy": {
        "apiVersion": "safe-runtime.dev/v1alpha1",
        "kind": "CapabilityPolicy",
        "metadata": {
          "name": "ignored"
        },
        "spec": {
          "defaultEffect": "deny",
          "rules": [
            {
              "id": "r",
              "effect": "allow",
              "capabilities": [
                "fs.read"
              ],
              "resources": [
                "workspace://src/**"
              ],
              "subjects": [
                "subject:future"
              ],
              "constraints": {
                "future": true
              },
              "lease": {
                "ttlMs": 60000,
                "maxUses": 1
              }
            }
          ]
        }
      },
      "expect": {
        "status": "DIAGNOSED",
        "diagnostics": [],
        "truncated": false
      }
    }

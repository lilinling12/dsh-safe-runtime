    {
      "id": "deterministic-multi-diagnostic-order",
      "policy": {
        "apiVersion": "safe-runtime.dev/v1alpha1",
        "kind": "CapabilityPolicy",
        "metadata": {
          "name": "order"
        },
        "spec": {
          "defaultEffect": "deny",
          "rules": [
            {
              "id": "dup",
              "effect": "deny",
              "capabilities": [
                "fs.write"
              ],
              "resources": [
                "workspace://foo/**bar",
                "file://x"
              ],
              "priority": 9
            },
            {
              "id": "dup",
              "effect": "allow",
              "capabilities": [
                "fs.read"
              ],
              "resources": [
                "workspace/src/**"
              ],
              "priority": 0
            }
          ]
        }
      },
      "expect": {
        "status": "DIAGNOSED",
        "diagnostics": [
          {
            "severity": "ERROR",
            "code": "RESOURCE_PATTERN_SYNTAX_INVALID",
            "instancePath": "/spec/rules/0/resources/0"
          },
          {
            "severity": "ERROR",
            "code": "RESOURCE_SCHEME_UNSUPPORTED",
            "instancePath": "/spec/rules/0/resources/1"
          },
          {
            "severity": "WARNING",
            "code": "POLICY_DIAGNOSTIC_REDUNDANT_DENY_PRIORITY",
            "instancePath": "/spec/rules/0/priority"
          },
          {
            "severity": "WARNING",
            "code": "POLICY_DIAGNOSTIC_DUPLICATE_RULE_ID",
            "instancePath": "/spec/rules/1/id",
            "relatedPaths": [
              "/spec/rules/0/id"
            ]
          },
          {
            "severity": "ERROR",
            "code": "RESOURCE_SELECTOR_SYNTAX_INVALID",
            "instancePath": "/spec/rules/1/resources/0"
          },
          {
            "severity": "WARNING",
            "code": "POLICY_DIAGNOSTIC_REDUNDANT_ZERO_PRIORITY",
            "instancePath": "/spec/rules/1/priority"
          }
        ],
        "truncated": false
      }

{
  "cases": [
    {
      "id": "valid-policy-no-diagnostics",
      "policy": {
        "apiVersion": "safe-runtime.dev/v1alpha1",
        "kind": "CapabilityPolicy",
        "metadata": {
          "name": "clean"
        },
        "spec": {
          "defaultEffect": "deny",
          "rules": [
            {
              "id": "allow-read",
              "effect": "allow",
              "capabilities": [
                "fs.read"
              ],
              "resources": [
                "workspace://src/**"
              ]
            }
          ]
        }
      },
      "expect": {
        "status": "DIAGNOSED",
        "diagnostics": [],
        "truncated": false
      }
    },

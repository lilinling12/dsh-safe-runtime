    {
      "id": "duplicate-rule-id",
      "policy": {
        "apiVersion": "safe-runtime.dev/v1alpha1",
        "kind": "CapabilityPolicy",
        "metadata": {
          "name": "duplicate"
        },
        "spec": {
          "defaultEffect": "deny",
          "rules": [
            {
              "id": "same",
              "effect": "allow",
              "capabilities": [
                "fs.read"
              ],
              "resources": [
                "workspace://a"
              ]
            },
            {
              "id": "same",
              "effect": "ask",
              "capabilities": [
                "fs.write"
              ],
              "resources": [
                "workspace://b"
              ]
            }
          ]
        }
      },
      "expect": {
        "status": "DIAGNOSED",
        "diagnostics": [
          {
            "severity": "WARNING",
            "code": "POLICY_DIAGNOSTIC_DUPLICATE_RULE_ID",
            "instancePath": "/spec/rules/1/id",
            "relatedPaths": [
              "/spec/rules/0/id"
            ]
          }
        ],
        "truncated": false
      }
    },

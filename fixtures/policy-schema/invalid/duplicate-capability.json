{
  "apiVersion": "safe-runtime.dev/v1alpha1",
  "kind": "CapabilityPolicy",
  "metadata": { "name": "duplicate-capability" },
  "spec": {
    "defaultEffect": "deny",
    "rules": [
      {
        "id": "read",
        "effect": "allow",
        "capabilities": ["fs.read", "fs.read"],
        "resources": ["workspace://**"]
      }
    ]
  }
}

{"profile":"M4-031_LEASE_USAGE_V1","description":"Portable deterministic CapabilityLease maxUses/remainingUses validity cases for Spec 0038.","cases":[{"id":"LUSE-001","description":"Single-use lease with one remaining use is usage-eligible.","input":{"profile":"M4-031_LEASE_USAGE_V1","maxUses":1,"remainingUses":1},"expected":{"status":"USAGE_ELIGIBLE","reasonCode":"LEASE_USAGE_AVAILABLE"}},{"id":"LUSE-002","description":"Single-use lease with zero remaining uses is exhausted.","input":{"profile":"M4-031_LEASE_USAGE_V1","maxUses":1,"remainingUses":0},"expected":{"status":"USAGE_INELIGIBLE","reasonCode":"LEASE_USAGE_EXHAUSTED"}},{"id":"LUSE-003","description":"Lease at its usage ceiling is eligible without inferring history.","input":{"profile":"M4-031_LEASE_USAGE_V1","maxUses":100,"remainingUses":100},"expected":{"status":"USAGE_ELIGIBLE","reasonCode":"LEASE_USAGE_AVAILABLE"}},{"id":"LUSE-004","description":"Lease with exactly one remaining use is eligible.","input":{"profile":"M4-031_LEASE_USAGE_V1","maxUses":100,"remainingUses":1},"expected":{"status":"USAGE_ELIGIBLE","reasonCode":"LEASE_USAGE_AVAILABLE"}},{"id":"LUSE-005","description":"An existing lease above the leaseRequest maxUses maximum is not rejected merely for exceeding 100000.","input":{"profile":"M4-031_LEASE_USAGE_V1","maxUses":100001,"remainingUses":100001},"expected":{"status":"USAGE_ELIGIBLE","reasonCode":"LEASE_USAGE_AVAILABLE"}},{"id":"LUSE-006","description":"Largest portable exact counter value is eligible.","input":{"profile":"M4-031_LEASE_USAGE_V1","maxUses":9007199254740991,"remainingUses":9007199254740991},"expected":{"status":"USAGE_ELIGIBLE","reasonCode":"LEASE_USAGE_AVAILABLE"}},{"id":"LUSE-007","description":"Largest portable maxUses with zero remaining uses is exhausted.","input":{"profile":"M4-031_LEASE_USAGE_V1","maxUses":9007199254740991,"remainingUses":0},"expected":{"status":"USAGE_INELIGIBLE","reasonCode":"LEASE_USAGE_EXHAUSTED"}},{"id":"LUSE-008","description":"remainingUses greater than maxUses is incoherent lifecycle state.","input":{"profile":"M4-031_LEASE_USAGE_V1","maxUses":10,"remainingUses":11},"expected":{"status":"FAIL_CLOSED","stage":"USAGE","reasonCode":"LEASE_USAGE_STATE_INVALID"}},{"id":"LUSE-009","description":"remainingUses greater than a single-use ceiling fails closed.","input":{"profile":"M4-031_LEASE_USAGE_V1","maxUses":1,"remainingUses":2},"expected":{"status":"FAIL_CLOSED","stage":"USAGE","reasonCode":"LEASE_USAGE_STATE_INVALID"}},{"id":"LUSE-010","description":"Zero maxUses violates the existing lease counter domain.","input":{"profile":"M4-031_LEASE_USAGE_V1","maxUses":0,"remainingUses":0},"expected":{"status":"FAIL_CLOSED","stage":"USAGE","reasonCode":"LEASE_USAGE_MAX_USES_INVALID"}},{"id":"LUSE-011","description":"Negative maxUses fails closed.","input":{"profile":"M4-031_LEASE_USAGE_V1","maxUses":-1,"remainingUses":0},"expected":{"status":"FAIL_CLOSED","stage":"USAGE","reasonCode":"LEASE_USAGE_MAX_USES_INVALID"}},{"id":"LUSE-012","description":"Fractional maxUses fails closed.","input":{"profile":"M4-031_LEASE_USAGE_V1","maxUses":1.5,"remainingUses":1},"expected":{"status":"FAIL_CLOSED","stage":"USAGE","reasonCode":"LEASE_USAGE_MAX_USES_INVALID"}},{"id":"LUSE-013","description":"String maxUses is not coerced.","input":{"profile":"M4-031_LEASE_USAGE_V1","maxUses":"1","remainingUses":1},"expected":{"status":"FAIL_CLOSED","stage":"USAGE","reasonCode":"LEASE_USAGE_MAX_USES_INVALID"}},{"id":"LUSE-014","description":"Null maxUses fails closed.","input":{"profile":"M4-031_LEASE_USAGE_V1","maxUses":null,"remainingUses":0},"expected":{"status":"FAIL_CLOSED","stage":"USAGE","reasonCode":"LEASE_USAGE_MAX_USES_INVALID"}},{"id":"LUSE-015","description":"maxUses above the portable exact integer ceiling fails closed.","input":{"profile":"M4-031_LEASE_USAGE_V1","maxUses":9007199254740992,"remainingUses":1},"expected":{"status":"FAIL_CLOSED","stage":"USAGE","reasonCode":"LEASE_USAGE_MAX_USES_INVALID"}},{"id":"LUSE-016","description":"Negative remainingUses fails closed.","input":{"profile":"M4-031_LEASE_USAGE_V1","maxUses":1,"remainingUses":-1},"expected":{"status":"FAIL_CLOSED","stage":"USAGE","reasonCode":"LEASE_USAGE_REMAINING_USES_INVALID"}},{"id":"LUSE-017","description":"Fractional remainingUses fails closed.","input":{"profile":"M4-031_LEASE_USAGE_V1","maxUses":2,"remainingUses":1.5},"expected":{"status":"FAIL_CLOSED","stage":"USAGE","reasonCode":"LEASE_USAGE_REMAINING_USES_INVALID"}},{"id":"LUSE-018","description":"String remainingUses is not coerced.","input":{"profile":"M4-031_LEASE_USAGE_V1","maxUses":1,"remainingUses":"0"},"expected":{"status":"FAIL_CLOSED","stage":"USAGE","reasonCode":"LEASE_USAGE_REMAINING_USES_INVALID"}},{"id":"LUSE-019","description":"Null remainingUses fails closed.","input":{"profile":"M4-031_LEASE_USAGE_V1","maxUses":1,"remainingUses":null},"expected":{"status":"FAIL_CLOSED","stage":"USAGE","reasonCode":"LEASE_USAGE_REMAINING_USES_INVALID"}},{"id":"LUSE-020","description":"remainingUses above the portable exact integer ceiling fails closed before coherence comparison.","input":{"profile":"M4-031_LEASE_USAGE_V1","maxUses":9007199254740991,"remainingUses":9007199254740992},"expected":{"status":"FAIL_CLOSED","stage":"USAGE","reasonCode":"LEASE_USAGE_REMAINING_USES_INVALID"}},{"id":"LUSE-021","description":"maxUses validation precedes remainingUses validation.","input":{"profile":"M4-031_LEASE_USAGE_V1","maxUses":"bad","remainingUses":"also-bad"},"expected":{"status":"FAIL_CLOSED","stage":"USAGE","reasonCode":"LEASE_USAGE_MAX_USES_INVALID"}},{"id":"LUSE-022","description":"Unknown profile fails before counter validation.","input":{"profile":"M4-031_LEASE_USAGE_V2","maxUses":"bad","remainingUses":"also-bad"},"expected":{"status":"FAIL_CLOSED","stage":"INPUT","reasonCode":"LEASE_USAGE_PROFILE_INVALID"}},{"id":"LUSE-023","description":"Missing maxUses is an outer input failure.","input":{"profile":"M4-031_LEASE_USAGE_V1","remainingUses":0},"expected":{"status":"FAIL_CLOSED","stage":"INPUT","reasonCode":"LEASE_USAGE_INPUT_INVALID"}},{"id":"LUSE-024","description":"Missing remainingUses is an outer input failure.","input":{"profile":"M4-031_LEASE_USAGE_V1","maxUses":1},"expected":{"status":"FAIL_CLOSED","stage":"INPUT","reasonCode":"LEASE_USAGE_INPUT_INVALID"}},{"id":"LUSE-025","description":"Unexpected ttl field fails closed instead of composing M4-030 implicitly.","input":{"profile":"M4-031_LEASE_USAGE_V1","maxUses":1,"remainingUses":1,"expiresAt":"2026-09-02T00:00:00Z"},"expected":{"status":"FAIL_CLOSED","stage":"INPUT","reasonCode":"LEASE_USAGE_INPUT_INVALID"}},{"id":"LUSE-026","description":"Null outer input fails closed.","input":null,"expected":{"status":"FAIL_CLOSED","stage":"INPUT","reasonCode":"LEASE_USAGE_INPUT_INVALID"}},{"id":"LUSE-027","description":"Array outer input fails closed.","input":[],"expected":{"status":"FAIL_CLOSED","stage":"INPUT","reasonCode":"LEASE_USAGE_INPUT_INVALID"}},{"id":"LUSE-028","description":"Boolean maxUses is not treated as integer one.","input":{"profile":"M4-031_LEASE_USAGE_V1","maxUses":true,"remainingUses":1},"expected":{"status":"FAIL_CLOSED","stage":"USAGE","reasonCode":"LEASE_USAGE_MAX_USES_INVALID"}},{"id":"LUSE-029","description":"Boolean remainingUses is not treated as integer zero or one.","input":{"profile":"M4-031_LEASE_USAGE_V1","maxUses":1,"remainingUses":false},"expected":{"status":"FAIL_CLOSED","stage":"USAGE","reasonCode":"LEASE_USAGE_REMAINING_USES_INVALID"}},{"id":"LUSE-030","description":"An ordinary exact integer represented in JSON numeric notation remains eligible.","input":{"profile":"M4-031_LEASE_USAGE_V1","maxUses":1000,"remainingUses":1000},"expected":{"status":"USAGE_ELIGIBLE","reasonCode":"LEASE_USAGE_AVAILABLE"}},{"id":"LUSE-031","description":"JSON negative zero is numeric zero and therefore exhausted.","input":{"profile":"M4-031_LEASE_USAGE_V1","maxUses":1,"remainingUses":-0},"expected":{"status":"USAGE_INELIGIBLE","reasonCode":"LEASE_USAGE_EXHAUSTED"}},{"id":"LUSE-032","description":"Value immediately below the portable exact integer ceiling remains eligible.","input":{"profile":"M4-031_LEASE_USAGE_V1","maxUses":9007199254740991,"remainingUses":9007199254740990},"expected":{"status":"USAGE_ELIGIBLE","reasonCode":"LEASE_USAGE_AVAILABLE"}}]}
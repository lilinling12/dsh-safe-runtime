{
  "profile": {
    "id": "m4-capability-lease-lookup-v1",
    "spec": "specs/0033-m4-capability-lease-lookup.md",
    "protocolVersion": "safe-runtime.dev/v1alpha1"
  },
  "cases": [
    {
      "id": "LEASE-LOOKUP-001",
      "description": "one exact Subject reference, capability, and Resource match is returned as a candidate",
      "subject": { "kind": "agent", "id": "agent/root", "sessionRef": "session:1" },
      "capability": "process.exec",
      "resource": { "scheme": "process", "locator": "git" },
      "leases": [
        { "leaseRef": "lease:01", "subjectRef": "agent/root", "capability": "process.exec", "resource": { "scheme": "process", "locator": "git" } }
      ],
      "expected": { "status": "CANDIDATES_FOUND", "candidateLeaseRefs": ["lease:01"] }
    },
    {
      "id": "LEASE-LOOKUP-002",
      "description": "Subject reference matching uses resolved Subject id exactly",
      "subject": { "kind": "agent", "id": "agent/root", "sessionRef": "session:1" },
      "capability": "process.exec",
      "resource": { "scheme": "process", "locator": "git" },
      "leases": [
        { "leaseRef": "lease:other", "subjectRef": "agent/other", "capability": "process.exec", "resource": { "scheme": "process", "locator": "git" } }
      ],
      "expected": { "status": "NO_CANDIDATE", "candidateLeaseRefs": [] }
    },
    {
      "id": "LEASE-LOOKUP-003",
      "description": "Subject kind is not concatenated into lease subjectRef",
      "subject": { "kind": "agent", "id": "agent/root", "sessionRef": "session:1" },
      "capability": "process.exec",
      "resource": { "scheme": "process", "locator": "git" },
      "leases": [
        { "leaseRef": "lease:synthetic", "subjectRef": "agent://agent/root", "capability": "process.exec", "resource": { "scheme": "process", "locator": "git" } }
      ],
      "expected": { "status": "NO_CANDIDATE", "candidateLeaseRefs": [] }
    },
    {
      "id": "LEASE-LOOKUP-004",
      "description": "capability matching is exact and case-sensitive",
      "subject": { "kind": "agent", "id": "agent/root", "sessionRef": "session:1" },
      "capability": "process.exec",
      "resource": { "scheme": "process", "locator": "git" },
      "leases": [
        { "leaseRef": "lease:case", "subjectRef": "agent/root", "capability": "Process.exec", "resource": { "scheme": "process", "locator": "git" } }
      ],
      "expected": { "status": "FAIL_CLOSED", "stage": "LEASE_SNAPSHOT", "reasonCode": "LEASE_LOOKUP_CAPABILITY_INVALID" }
    },
    {
      "id": "LEASE-LOOKUP-005",
      "description": "valid but different capability produces no candidate",
      "subject": { "kind": "agent", "id": "agent/root", "sessionRef": "session:1" },
      "capability": "process.exec",
      "resource": { "scheme": "process", "locator": "git" },
      "leases": [
        { "leaseRef": "lease:resolve", "subjectRef": "agent/root", "capability": "process.resolve", "resource": { "scheme": "process", "locator": "git" } }
      ],
      "expected": { "status": "NO_CANDIDATE", "candidateLeaseRefs": [] }
    },
    {
      "id": "LEASE-LOOKUP-006",
      "description": "Resource scheme mismatch produces no candidate",
      "subject": { "kind": "agent", "id": "agent/root", "sessionRef": "session:1" },
      "capability": "fs.read",
      "resource": { "scheme": "workspace", "locator": "src/a.ts" },
      "leases": [
        { "leaseRef": "lease:host", "subjectRef": "agent/root", "capability": "fs.read", "resource": { "scheme": "hostfs", "locator": "src/a.ts" } }
      ],
      "expected": { "status": "NO_CANDIDATE", "candidateLeaseRefs": [] }
    },
    {
      "id": "LEASE-LOOKUP-007",
      "description": "Resource locator mismatch produces no candidate",
      "subject": { "kind": "agent", "id": "agent/root", "sessionRef": "session:1" },
      "capability": "fs.read",
      "resource": { "scheme": "workspace", "locator": "src/a.ts" },
      "leases": [
        { "leaseRef": "lease:b", "subjectRef": "agent/root", "capability": "fs.read", "resource": { "scheme": "workspace", "locator": "src/b.ts" } }
      ],
      "expected": { "status": "NO_CANDIDATE", "candidateLeaseRefs": [] }
    },
    {
      "id": "LEASE-LOOKUP-008",
      "description": "wildcard-looking Lease locator is exact data and is not a policy glob",
      "subject": { "kind": "agent", "id": "agent/root", "sessionRef": "session:1" },
      "capability": "fs.read",
      "resource": { "scheme": "workspace", "locator": "src/a.ts" },
      "leases": [
        { "leaseRef": "lease:glob-looking", "subjectRef": "agent/root", "capability": "fs.read", "resource": { "scheme": "workspace", "locator": "src/**" } }
      ],
      "expected": { "status": "NO_CANDIDATE", "candidateLeaseRefs": [] }
    },
    {
      "id": "LEASE-LOOKUP-009",
      "description": "equal providerIdentity is part of exact Resource equality",
      "subject": { "kind": "agent", "id": "agent/root", "sessionRef": "session:1" },
      "capability": "fs.read",
      "resource": { "scheme": "workspace", "locator": "src/a.ts", "providerIdentity": "provider:1" },
      "leases": [
        { "leaseRef": "lease:provider", "subjectRef": "agent/root", "capability": "fs.read", "resource": { "scheme": "workspace", "locator": "src/a.ts", "providerIdentity": "provider:1" } }
      ],
      "expected": { "status": "CANDIDATES_FOUND", "candidateLeaseRefs": ["lease:provider"] }
    },
    {
      "id": "LEASE-LOOKUP-010",
      "description": "different providerIdentity produces no candidate",
      "subject": { "kind": "agent", "id": "agent/root", "sessionRef": "session:1" },
      "capability": "fs.read",
      "resource": { "scheme": "workspace", "locator": "src/a.ts", "providerIdentity": "provider:1" },
      "leases": [
        { "leaseRef": "lease:provider", "subjectRef": "agent/root", "capability": "fs.read", "resource": { "scheme": "workspace", "locator": "src/a.ts", "providerIdentity": "provider:2" } }
      ],
      "expected": { "status": "NO_CANDIDATE", "candidateLeaseRefs": [] }
    },
    {
      "id": "LEASE-LOOKUP-011",
      "description": "providerIdentity presence mismatch produces no candidate",
      "subject": { "kind": "agent", "id": "agent/root", "sessionRef": "session:1" },
      "capability": "fs.read",
      "resource": { "scheme": "workspace", "locator": "src/a.ts", "providerIdentity": "provider:1" },
      "leases": [
        { "leaseRef": "lease:no-provider", "subjectRef": "agent/root", "capability": "fs.read", "resource": { "scheme": "workspace", "locator": "src/a.ts" } }
      ],
      "expected": { "status": "NO_CANDIDATE", "candidateLeaseRefs": [] }
    },
    {
      "id": "LEASE-LOOKUP-012",
      "description": "multiple exact candidates are all returned in Unicode code-point leaseRef order",
      "subject": { "kind": "agent", "id": "agent/root", "sessionRef": "session:1" },
      "capability": "process.exec",
      "resource": { "scheme": "process", "locator": "git" },
      "leases": [
        { "leaseRef": "lease:z", "subjectRef": "agent/root", "capability": "process.exec", "resource": { "scheme": "process", "locator": "git" } },
        { "leaseRef": "lease:A", "subjectRef": "agent/root", "capability": "process.exec", "resource": { "scheme": "process", "locator": "git" } },
        { "leaseRef": "lease:ä", "subjectRef": "agent/root", "capability": "process.exec", "resource": { "scheme": "process", "locator": "git" } }
      ],
      "expected": { "status": "CANDIDATES_FOUND", "candidateLeaseRefs": ["lease:A", "lease:z", "lease:ä"] }
    },
    {
      "id": "LEASE-LOOKUP-013",
      "description": "snapshot order does not change deterministic candidate order",
      "subject": { "kind": "agent", "id": "agent/root", "sessionRef": "session:1" },
      "capability": "process.exec",
      "resource": { "scheme": "process", "locator": "git" },
      "leases": [
        { "leaseRef": "lease:ä", "subjectRef": "agent/root", "capability": "process.exec", "resource": { "scheme": "process", "locator": "git" } },
        { "leaseRef": "lease:z", "subjectRef": "agent/root", "capability": "process.exec", "resource": { "scheme": "process", "locator": "git" } },
        { "leaseRef": "lease:A", "subjectRef": "agent/root", "capability": "process.exec", "resource": { "scheme": "process", "locator": "git" } }
      ],
      "expected": { "status": "CANDIDATES_FOUND", "candidateLeaseRefs": ["lease:A", "lease:z", "lease:ä"] }
    },
    {
      "id": "LEASE-LOOKUP-014",
      "description": "duplicate leaseRef fails globally even when one duplicate would not match the request",
      "subject": { "kind": "agent", "id": "agent/root", "sessionRef": "session:1" },
      "capability": "process.exec",
      "resource": { "scheme": "process", "locator": "git" },
      "leases": [
        { "leaseRef": "lease:dup", "subjectRef": "agent/root", "capability": "process.exec", "resource": { "scheme": "process", "locator": "git" } },
        { "leaseRef": "lease:dup", "subjectRef": "agent/other", "capability": "fs.read", "resource": { "scheme": "workspace", "locator": "other" } }
      ],
      "expected": { "status": "FAIL_CLOSED", "stage": "LEASE_SNAPSHOT", "reasonCode": "LEASE_LOOKUP_DUPLICATE_LEASE_REF" }
    },
    {
      "id": "LEASE-LOOKUP-015",
      "description": "empty leaseRef is invalid during request-independent preflight",
      "subject": { "kind": "agent", "id": "agent/root", "sessionRef": "session:1" },
      "capability": "process.exec",
      "resource": { "scheme": "process", "locator": "git" },
      "leases": [
        { "leaseRef": "", "subjectRef": "agent/other", "capability": "fs.read", "resource": { "scheme": "workspace", "locator": "other" } }
      ],
      "expected": { "status": "FAIL_CLOSED", "stage": "LEASE_SNAPSHOT", "reasonCode": "LEASE_LOOKUP_LEASE_REF_INVALID" }
    },
    {
      "id": "LEASE-LOOKUP-016",
      "description": "empty subjectRef is invalid during request-independent preflight",
      "subject": { "kind": "agent", "id": "agent/root", "sessionRef": "session:1" },
      "capability": "process.exec",
      "resource": { "scheme": "process", "locator": "git" },
      "leases": [
        { "leaseRef": "lease:bad-subject", "subjectRef": "", "capability": "fs.read", "resource": { "scheme": "workspace", "locator": "other" } }
      ],
      "expected": { "status": "FAIL_CLOSED", "stage": "LEASE_SNAPSHOT", "reasonCode": "LEASE_LOOKUP_SUBJECT_REF_INVALID" }
    },
    {
      "id": "LEASE-LOOKUP-017",
      "description": "malformed Lease resource preserves accepted M4-003 failure",
      "subject": { "kind": "agent", "id": "agent/root", "sessionRef": "session:1" },
      "capability": "process.exec",
      "resource": { "scheme": "process", "locator": "git" },
      "leases": [
        { "leaseRef": "lease:bad-resource", "subjectRef": "agent/other", "capability": "fs.read", "resource": { "scheme": "Workspace", "locator": "other" } }
      ],
      "expected": { "status": "FAIL_CLOSED", "stage": "RESOURCE", "reasonCode": "RESOURCE_SCHEME_UNSUPPORTED" }
    },
    {
      "id": "LEASE-LOOKUP-018",
      "description": "omitted constraints add no lookup predicate",
      "subject": { "kind": "agent", "id": "agent/root", "sessionRef": "session:1" },
      "capability": "process.exec",
      "resource": { "scheme": "process", "locator": "git" },
      "leases": [
        { "leaseRef": "lease:no-constraints", "subjectRef": "agent/root", "capability": "process.exec", "resource": { "scheme": "process", "locator": "git" } }
      ],
      "expected": { "status": "CANDIDATES_FOUND", "candidateLeaseRefs": ["lease:no-constraints"] }
    },
    {
      "id": "LEASE-LOOKUP-019",
      "description": "empty constraints are zero portable predicates",
      "subject": { "kind": "agent", "id": "agent/root", "sessionRef": "session:1" },
      "capability": "process.exec",
      "resource": { "scheme": "process", "locator": "git" },
      "leases": [
        { "leaseRef": "lease:empty-constraints", "subjectRef": "agent/root", "capability": "process.exec", "resource": { "scheme": "process", "locator": "git" }, "constraints": {} }
      ],
      "expected": { "status": "CANDIDATES_FOUND", "candidateLeaseRefs": ["lease:empty-constraints"] }
    },
    {
      "id": "LEASE-LOOKUP-020",
      "description": "non-empty constraints on otherwise exact Lease fail closed rather than being ignored",
      "subject": { "kind": "agent", "id": "agent/root", "sessionRef": "session:1" },
      "capability": "process.exec",
      "resource": { "scheme": "process", "locator": "git" },
      "leases": [
        { "leaseRef": "lease:argv", "subjectRef": "agent/root", "capability": "process.exec", "resource": { "scheme": "process", "locator": "git" }, "constraints": { "argvPrefix": ["push"] } }
      ],
      "expected": { "status": "FAIL_CLOSED", "stage": "CONSTRAINT", "reasonCode": "LEASE_CONSTRAINT_PROFILE_UNSUPPORTED" }
    },
    {
      "id": "LEASE-LOOKUP-021",
      "description": "non-empty constraints on Subject-nonmatching Lease are not unrelated blockers",
      "subject": { "kind": "agent", "id": "agent/root", "sessionRef": "session:1" },
      "capability": "process.exec",
      "resource": { "scheme": "process", "locator": "git" },
      "leases": [
        { "leaseRef": "lease:other-subject", "subjectRef": "agent/other", "capability": "process.exec", "resource": { "scheme": "process", "locator": "git" }, "constraints": { "future": true } }
      ],
      "expected": { "status": "NO_CANDIDATE", "candidateLeaseRefs": [] }
    },
    {
      "id": "LEASE-LOOKUP-022",
      "description": "non-empty constraints on capability-nonmatching Lease are not unrelated blockers",
      "subject": { "kind": "agent", "id": "agent/root", "sessionRef": "session:1" },
      "capability": "process.exec",
      "resource": { "scheme": "process", "locator": "git" },
      "leases": [
        { "leaseRef": "lease:other-capability", "subjectRef": "agent/root", "capability": "process.resolve", "resource": { "scheme": "process", "locator": "git" }, "constraints": { "future": true } }
      ],
      "expected": { "status": "NO_CANDIDATE", "candidateLeaseRefs": [] }
    },
    {
      "id": "LEASE-LOOKUP-023",
      "description": "non-empty constraints on Resource-nonmatching Lease are not unrelated blockers",
      "subject": { "kind": "agent", "id": "agent/root", "sessionRef": "session:1" },
      "capability": "process.exec",
      "resource": { "scheme": "process", "locator": "git" },
      "leases": [
        { "leaseRef": "lease:other-resource", "subjectRef": "agent/root", "capability": "process.exec", "resource": { "scheme": "process", "locator": "node" }, "constraints": { "future": true } }
      ],
      "expected": { "status": "NO_CANDIDATE", "candidateLeaseRefs": [] }
    },
    {
      "id": "LEASE-LOOKUP-024",
      "description": "expired-looking timestamp does not turn M4-022 lookup into TTL validation",
      "subject": { "kind": "agent", "id": "agent/root", "sessionRef": "session:1" },
      "capability": "process.exec",
      "resource": { "scheme": "process", "locator": "git" },
      "leases": [
        { "leaseRef": "lease:expired-looking", "subjectRef": "agent/root", "capability": "process.exec", "resource": { "scheme": "process", "locator": "git" }, "issuedAt": "2020-01-01T00:00:00Z", "expiresAt": "2020-01-01T00:01:00Z", "maxUses": 1, "remainingUses": 1, "authorization": { "kind": "approval", "ref": "approval:old" } }
      ],
      "expected": { "status": "CANDIDATES_FOUND", "candidateLeaseRefs": ["lease:expired-looking"] }
    },
    {
      "id": "LEASE-LOOKUP-025",
      "description": "remainingUses zero does not turn M4-022 lookup into usage validity or consume",
      "subject": { "kind": "agent", "id": "agent/root", "sessionRef": "session:1" },
      "capability": "process.exec",
      "resource": { "scheme": "process", "locator": "git" },
      "leases": [
        { "leaseRef": "lease:zero", "subjectRef": "agent/root", "capability": "process.exec", "resource": { "scheme": "process", "locator": "git" }, "issuedAt": "2030-01-01T00:00:00Z", "expiresAt": "2030-01-01T00:01:00Z", "maxUses": 1, "remainingUses": 0, "authorization": { "kind": "approval", "ref": "approval:future" } }
      ],
      "expected": { "status": "CANDIDATES_FOUND", "candidateLeaseRefs": ["lease:zero"] }
    },
    {
      "id": "LEASE-LOOKUP-026",
      "description": "parentLeaseRef is not traversed or ranked during lookup",
      "subject": { "kind": "subagent", "id": "subagent:child", "parent": "agent/root", "sessionRef": "session:1" },
      "capability": "fs.read",
      "resource": { "scheme": "workspace", "locator": "src/a.ts" },
      "leases": [
        { "leaseRef": "lease:child", "subjectRef": "subagent:child", "parentLeaseRef": "lease:missing-parent", "capability": "fs.read", "resource": { "scheme": "workspace", "locator": "src/a.ts" } }
      ],
      "expected": { "status": "CANDIDATES_FOUND", "candidateLeaseRefs": ["lease:child"] }
    },
    {
      "id": "LEASE-LOOKUP-027",
      "description": "authorization kind does not create lookup precedence",
      "subject": { "kind": "agent", "id": "agent/root", "sessionRef": "session:1" },
      "capability": "process.exec",
      "resource": { "scheme": "process", "locator": "git" },
      "leases": [
        { "leaseRef": "lease:system", "subjectRef": "agent/root", "capability": "process.exec", "resource": { "scheme": "process", "locator": "git" }, "authorization": { "kind": "system", "ref": "system:1" } },
        { "leaseRef": "lease:approval", "subjectRef": "agent/root", "capability": "process.exec", "resource": { "scheme": "process", "locator": "git" }, "authorization": { "kind": "approval", "ref": "approval:1" } }
      ],
      "expected": { "status": "CANDIDATES_FOUND", "candidateLeaseRefs": ["lease:approval", "lease:system"] }
    }
  ]
}

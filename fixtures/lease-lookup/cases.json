  "cases": [
    {
      "id": "LEASE-LOOKUP-001",
      "description": "one exact Subject reference, capability, and Resource match is returned as a candidate",
      "subject": { "kind": "agent", "id": "agent/root", "sessionRef": "session:1" },
      "capability": "process.exec",
      "resource": { "scheme": "process", "locator": "git" },
      "leases": [
        {
          "apiVersion": "safe-runtime.dev/v1alpha1",
          "kind": "CapabilityLease",
          "leaseRef": "lease:01",
          "subjectRef": "agent/root",
          "capability": "process.exec",
          "resource": { "scheme": "process", "locator": "git" },
          "issuedAt": "2030-01-01T00:00:00Z",
          "expiresAt": "2030-01-01T00:05:00Z",
          "maxUses": 3,
          "remainingUses": 3,
          "authorization": { "kind": "approval", "ref": "approval:fixture" }
        }
      ],
      "expected": { "status": "CANDIDATES_FOUND", "candidateLeaseRefs": ["lease:01"] }
    },
    {

{
  "profile": {
    "id": "m4-builtin-shell-rc5",
    "harnessVersion": "0.1.0-rc.5",
    "harnessCommit": "47f943859bef60e4160492346772ded9b24f765a",
    "spec": "specs/0027-m4-builtin-shell-tool-classification.md"
  },
  "cases": [
    {
      "id": "SHELL-CLS-001",
      "description": "bash foreground command without workdir uses unresolved execution root",
      "toolName": "bash",
      "arguments": {
        "command": "git status",
        "description": "Show working tree status"
      },
      "expected": {
        "status": "CLASSIFIED",
        "requirements": [
          {
            "capability": "process.exec",
            "operand": {
              "source": "SHELL_COMMAND",
              "dialect": "BASH",
              "rawCommand": "git status",
              "executionMode": "FOREGROUND",
              "workdir": {
                "source": "EXECUTION_ROOT"
              }
            }
          }
        ]
      }
    },
    {
      "id": "SHELL-CLS-002",
      "description": "bash preserves an explicit relative workdir without resolving it",
      "toolName": "bash",
      "arguments": {
        "command": "pnpm test",
        "description": "Run project test suite",
        "workdir": "packages/core"
      },
      "expected": {
        "status": "CLASSIFIED",
        "requirements": [
          {
            "capability": "process.exec",
            "operand": {
              "source": "SHELL_COMMAND",
              "dialect": "BASH",
              "rawCommand": "pnpm test",
              "executionMode": "FOREGROUND",
              "workdir": {
                "source": "ARGUMENT_WORKDIR",
                "argumentName": "workdir",
                "rawWorkdir": "packages/core"
              }
            }
          }
        ]
      }
    },
    {
      "id": "SHELL-CLS-003",
      "description": "bash true run_in_background records background execution intent",
      "toolName": "bash",
      "arguments": {
        "command": "pnpm dev",
        "description": "Start development server",
        "run_in_background": true
      },
      "expected": {
        "status": "CLASSIFIED",
        "requirements": [
          {
            "capability": "process.exec",
            "operand": {
              "source": "SHELL_COMMAND",
              "dialect": "BASH",
              "rawCommand": "pnpm dev",
              "executionMode": "BACKGROUND",
              "workdir": {
                "source": "EXECUTION_ROOT"
              }
            }
          }
        ]
      }
    },
    {
      "id": "SHELL-CLS-004",
      "description": "bash explicit false run_in_background remains foreground",

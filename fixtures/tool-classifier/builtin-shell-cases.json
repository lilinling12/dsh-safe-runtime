    {
      "id": "SHELL-CLS-012",
      "description": "classification ignores unrelated display timeout and escalation metadata",
      "toolName": "bash",
      "arguments": {
        "command": "make build",
        "description": "Build project artifacts",
        "timeoutMs": 30000,
        "sandbox_permissions": "workspace-write",
        "justification": "Required by an upstream approval flow",
        "unrelated": {
          "nested": "not retained"
        }
      },
      "expected": {
        "status": "CLASSIFIED",
        "requirements": [
          {
            "capability": "process.exec",
            "operand": {
              "source": "SHELL_COMMAND",
              "dialect": "BASH",
              "rawCommand": "make build",
              "executionMode": "FOREGROUND",
              "workdir": {
                "source": "EXECUTION_ROOT"
              }
            }
          }
        ]
      }
    },
    {
      "id": "SHELL-CLS-013",
      "description": "recognized tool requires an argument object",
      "toolName": "bash",
      "arguments": null,
      "expected": {
        "status": "ERROR",
        "reason": "SHELL_TOOL_ARGUMENTS_INVALID"
      }
    },
    {
      "id": "SHELL-CLS-014",
      "description": "recognized tool requires command",
      "toolName": "pwsh",
      "arguments": {
        "description": "Missing command"
      },
      "expected": {
        "status": "ERROR",
        "reason": "SHELL_TOOL_COMMAND_INVALID"
      }
    },
    {
      "id": "SHELL-CLS-015",
      "description": "recognized command may not be blank",
      "toolName": "bash",
      "arguments": {
        "command": "   ",

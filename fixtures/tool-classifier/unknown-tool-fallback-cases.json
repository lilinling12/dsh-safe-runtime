{
  "profile": {
    "id": "m4-unknown-tool-fallback-v1",
    "fallbackProfile": "STRICT_DENY_V1",
    "harnessVersion": "0.1.0-rc.5",
    "harnessCommit": "47f943859bef60e4160492346772ded9b24f765a",
    "spec": "specs/0029-m4-unknown-tool-fallback-resolution.md"
  },
  "cases": [
    {
      "id": "TOOL-FALLBACK-001",
      "description": "recognized filesystem classification is preserved",
      "fallbackProfile": "STRICT_DENY_V1",
      "toolName": "read",
      "arguments": {
        "file_path": "docs/README.md"
      },
      "expected": {
        "status": "CLASSIFIED",
        "requirements": [
          {
            "capability": "fs.stat",
            "operand": {
              "source": "ARGUMENT_PATH",
              "argumentName": "file_path",
              "rawPath": "docs/README.md",
              "reach": "EXACT"
            }
          },
          {
            "capability": "fs.read",
            "operand": {
              "source": "ARGUMENT_PATH",
              "argumentName": "file_path",
              "rawPath": "docs/README.md",
              "reach": "EXACT"
            }
          }
        ]
      }
    },
    {
      "id": "TOOL-FALLBACK-002",
      "description": "recognized shell classification is preserved",
      "fallbackProfile": "STRICT_DENY_V1",
      "toolName": "bash",
      "arguments": {
        "command": "git status"
      },
      "expected": {
        "status": "CLASSIFIED",
        "requirements": [
          {
            "capability": "process.exec",
            "operand": {
              "source": "SHELL_COMMAND",
              "dialect": "BASH",
              "rawCommand": "git status",
              "executionMode": "FOREGROUND",
              "workdir": {
                "source": "EXECUTION_ROOT"
              }
            }
          }
        ]
      }
    },
    {
      "id": "TOOL-FALLBACK-003",
      "description": "recognized filesystem malformed input preserves filesystem error",
      "fallbackProfile": "STRICT_DENY_V1",
      "toolName": "read",
      "arguments": {},
      "expected": {
        "status": "ERROR",
        "reason": "FS_TOOL_PATH_INVALID"
      }
    },
    {
      "id": "TOOL-FALLBACK-004",
      "description": "recognized shell malformed input preserves shell error",
      "fallbackProfile": "STRICT_DENY_V1",
      "toolName": "pwsh",
      "arguments": {
        "command": "   "
      },
      "expected": {
        "status": "ERROR",
        "reason": "SHELL_TOOL_COMMAND_INVALID"
      }
    },
    {
      "id": "TOOL-FALLBACK-005",
      "description": "ordinary unknown tool is blocked by strict fallback",
      "fallbackProfile": "STRICT_DENY_V1",
      "toolName": "custom_tool",
      "arguments": {
        "value": "ignored"
      },
      "expected": {
        "status": "UNCLASSIFIED",
        "profile": "STRICT_DENY_V1",
        "disposition": "BLOCK",
        "reason": "NO_APPLICABLE_CLASSIFIER"
      }
    },
    {
      "id": "TOOL-FALLBACK-006",
      "description": "shell alias is not inferred and remains blocked",
      "fallbackProfile": "STRICT_DENY_V1",
      "toolName": "sh",
      "arguments": {
        "command": "echo x"
      },
      "expected": {
        "status": "UNCLASSIFIED",
        "profile": "STRICT_DENY_V1",
        "disposition": "BLOCK",
        "reason": "NO_APPLICABLE_CLASSIFIER"
      }
    },
    {
      "id": "TOOL-FALLBACK-007",
      "description": "known-name case variant is not normalized",

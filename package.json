{
  "name": "@dsh-safe/root",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "lint": "oxlint .",
    "check:boundaries": "node scripts/verify-boundaries.mjs",
    "check:schemas": "node scripts/check-schema-shape.mjs",
    "check:testkit-package": "node scripts/check-testkit-package.mjs",
    "check:all": "pnpm check:boundaries && pnpm check:schemas && pnpm check:schema-baseline && pnpm typecheck && pnpm test && pnpm lint && pnpm check:testkit-package",
    "check:schema-baseline": "node scripts/check-schema-baseline.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "oxlint": "1.76.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
